# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-min-32-characters
JWT_EXPIRY=7d

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your_test_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_test_key_here
STRIPE_WEBHOOK_SECRET=whsec_test_your_webhook_secret_here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_test_key_here

# SendGrid Configuration
SENDGRID_API_KEY=SG.your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@mauiactivitieshu.com
SENDGRID_TEMPLATE_WELCOME=welcome_email_template_id
SENDGRID_TEMPLATE_PASS_EXPIRY_30=pass_expiry_30days_template_id
SENDGRID_TEMPLATE_PASS_EXPIRY_7=pass_expiry_7days_template_id
SENDGRID_TEMPLATE_RENEWAL_OFFER=renewal_offer_template_id
SENDGRID_TEMPLATE_VENDOR_ONBOARDING=vendor_onboarding_template_id

# App Configuration
NODE_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Maui Activities Hub

# Pass Configuration
PASS_VALIDITY_DAYS=180
PASS_RENEWAL_COST=10

# Affiliate Configuration
DEFAULT_AFFILIATE_COMMISSION_RATE=15
VIATOR_AFFILIATE_ID=your-viator-affiliate-id
GETYOURGUIDE_AFFILIATE_ID=your-getyourguide-affiliate-id

# Email Configuration
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey

# Admin Configuration
ADMIN_EMAIL=admin@mauiactivitieshu.com
ADMIN_PASSWORD_HASH=generated-bcrypt-hash

# Logging and Monitoring
LOG_LEVEL=info
SENTRY_DSN=optional-sentry-dsn

# Feature Flags
ENABLE_VENDOR_SIGNUP=true
ENABLE_REVIEWS=true
ENABLE_AFFILIATE_TRACKING=true
MAINTENANCE_MODE=false
